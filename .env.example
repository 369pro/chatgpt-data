DEEPSEEK_API_HOST=https://api.deepseek.com/
ZHIPU_ENABLED=false
ZHIPU_API_KEY=
ZHIPU_API_HOST=https://open.bigmodel.cn/api/paas/v4/chat/completions
# Match big-market's signing secret when using the linked account center.
APP_JWT_SECRET=
SERVER_PORT=8093
APP_CROSS_ORIGIN=http://localhost:3003
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/openai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
DUBBO_REGISTRY_ADDRESS=nacos://127.0.0.1:8848
BIG_MARKET_APP_TOKEN=
