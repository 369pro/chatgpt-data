<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.chatgpt.data.infrastructure.dao.IUserAccountDao">

    <resultMap id="userAccountMap" type="cn.bugstack.chatgpt.data.infrastructure.dao.po.UserAccountPO">
        <id column="id" property="id"/>
        <result column="openid" property="openid"/>
        <result column="model_types" property="modelTypes"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.bugstack.chatgpt.data.infrastructure.dao.po.UserAccountPO">
        INSERT INTO user_account(
        openid, model_types, status,
        create_time, update_time
        )
        VALUES(
        #{openid}, #{modelTypes}, #{status},
        now(), now()
        )
    </insert>

    <select id="queryUserAccount" parameterType="java.lang.String" resultMap="userAccountMap">
        SELECT openid, model_types, status
        FROM user_account
        WHERE openid = #{openid}
    </select>

</mapper>
