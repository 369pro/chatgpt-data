# Sandbox only. Keep real values in the ignored .env.payment file.
# Paste single-line PKCS8 private key and Alipay public key without PEM headers.
payment.alipay.enabled=true
payment.alipay.app-id=
payment.alipay.private-key=
payment.alipay.public-key=
payment.alipay.seller-id=
# Optional for local testing; authenticated polling and reconciliation still work.
payment.alipay.notify-url=
payment.alipay.return-url=http://localhost:3003/#/sale
